---
import { Icons } from '@/components/Icons';
import { skills } from '@/data';

// Skills that have a brand icon in Icons.tsx; the rest render as plain text.
const icons: Record<string, (props: { className?: string }) => any> = {
	TypeScript: Icons.typeScript,
	JavaScript: Icons.javaScript,
	React: Icons.react,
	'Next.js': Icons.nextJS,
	Astro: Icons.astro,
	NestJS: Icons.nestJS,
	Payload: Icons.payload,
	Figma: Icons.figma
};
---

<section class="mx-auto flex items-center justify-between pt-8 md:pt-12 lg:pt-24">
	<div class="flex w-full flex-col gap-y-4">
		<h2 class="border-b border-primary pb-2 text-2xl font-bold sm:text-3xl md:text-4xl lg:text-5xl">
			Skills
		</h2>
		{
			skills.map(({ category, items }, index) => (
				<article
					class:list={[
						'grid grid-cols-2 pb-4 md:pb-8',
						index > 0 && 'border-t border-primary pt-2',
						index === skills.length - 1 && 'pb-0 md:pb-0'
					]}
				>
					<h3 class="text-lg lg:text-xl">{category}</h3>
					<div class="grid gap-2 md:grid-cols-2">
						{items.map((item) => {
							const Icon = icons[item];
							return (
								<span class="flex items-center gap-x-2">
									{Icon && <Icon className="h-[18px] w-[18px] shrink-0" />}
									{item}
								</span>
							);
						})}
					</div>
				</article>
			))
		}
	</div>
</section>
